<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Bingo Mini App</title>

    <script src="https://telegram.org/js/telegram-web-app.js"></script>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #111827;
            color: white;
            text-align: center;
        }

        .header {
            padding: 20px;
            font-size: 26px;
            font-weight: bold;
        }

        .balance {
            margin: 10px auto 20px;
            padding: 15px;
            width: 85%;
            background: #1f2937;
            border-radius: 15px;
            font-size: 20px;
        }

        .card {
            width: 90%;
            max-width: 400px;
            margin: auto;
            background: #ffffff;
            padding: 10px;
            border-radius: 15px;
        }

        .row {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
        }

        .cell {
            margin: 3px;
            padding: 14px 5px;
            background: #e5e7eb;
            color: #111827;
            border-radius: 8px;
            font-weight: bold;
        }

        .title {
            color: #111827;
            font-size: 20px;
            padding: 8px;
        }

        button {
            margin: 20px 5px;
            padding: 14px 25px;
            border: none;
            border-radius: 12px;
            font-size: 17px;
            font-weight: bold;
        }

        .play {
            background: #22c55e;
            color: white;
        }

        .cash {
            background: #f59e0b;
            color: white;
        }
    </style>
</head>

<body>

    <div class="header">
        🎱 BINGO
    </div>

    <div class="balance">
        💰 Balance: <b id="balance">0.00 ETB</b>
    </div>

    <div class="card">
        <div class="title">B I N G O</div>

        <div class="row">
            <div class="cell">1</div>
            <div class="cell">16</div>
            <div class="cell">31</div>
            <div class="cell">46</div>
            <div class="cell">61</div>
        </div>

        <div class="row">
            <div class="cell">4</div>
            <div class="cell">19</div>
            <div class="cell">35</div>
            <div class="cell">49</div>
            <div class="cell">67</div>
        </div>

        <div class="row">
            <div class="cell">8</div>
            <div class="cell">23</div>
            <div class="cell">FREE</div>
            <div class="cell">52</div>
            <div class="cell">72</div>
        </div>

        <div class="row">
            <div class="cell">11</div>
            <div class="cell">27</div>
            <div class="cell">42</div>
            <div class="cell">56</div>
            <div class="cell">75</div>
        </div>

        <div class="row">
            <div class="cell">14</div>
            <div class="cell">30</div>
            <div class="cell">44</div>
            <div class="cell">59</div>
            <div class="cell">70</div>
        </div>
    </div>

    <button class="play" onclick="playBingo()">
        🎮 PLAY BINGO
    </button>

    <button class="cash" onclick="cashout()">
        💸 CASHOUT
    </button>

    <script>
        const tg = window.Telegram.WebApp;

        tg.ready();
        tg.expand();

        function playBingo() {
            alert("🎱 Bingo game starting...");
        }

        function cashout() {
            alert("💸 Cashout section");
        }
    </script>

</body>
</html>